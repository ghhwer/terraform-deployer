# Local build overrides for ./build.sh (copy to build.local.env and edit).
# build.local.env is gitignored — keep private mirrors / credentials out of git.
#
# USE_CUSTOM_PYPI=true
# CUSTOM_PYPI_URL=https://artifactory.example.com/repository/pypi/simple/
# CUSTOM_PYPI_HOST=artifactory.example.com
# CUSTOM_PYPI_NAME=artifactory
# IMAGE_TAG=tf-deployer:latest
# DOCKER=docker
